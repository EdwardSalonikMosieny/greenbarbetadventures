# Server
# 3070 is the port the production reverse proxy forwards /api/ to; keeping dev
# on the same port means one less thing that differs between environments.
PORT=3070
HOST=0.0.0.0
NODE_ENV=development

# Must match the frontend's dev/prod origin(s) exactly (cors is scoped, not wildcard).
# Comma-separated if serving both the apex and www domains, e.g.:
# FRONTEND_ORIGIN=https://greenbarbetadventures.com,https://www.greenbarbetadventures.com
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string — see backend README for local setup
DATABASE_URL="postgresql://user:password@localhost:5432/green_barbet_adventures?schema=public"

# JWT signing secret for admin auth — generate a long random value, never commit the real one
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_SALT_ROUNDS=12

# Used only by `npm run prisma:create-admin`; never commit real values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
ADMIN_NAME=Site Administrator
