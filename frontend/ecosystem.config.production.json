{
  "_comment": "PM2 resolves a relative script, log path and working directory against this file's own directory, so no absolute server path is hard-coded here. Start with: pm2 startOrReload frontend/ecosystem.config.production.json --only greenbarbet-web-prod --update-env",
  "apps": [
    {
      "name": "greenbarbet-web-prod",
      "script": "./server.js",
      "env": {
        "NODE_ENV": "production",
        "PORT": 5070,
        "HOST": "127.0.0.1"
      },
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "autorestart": true,
      "max_memory_restart": "500M",
      "error_file": "../logs/frontend-error.log",
      "out_file": "../logs/frontend-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "kill_timeout": 10000,
      "wait_ready": true,
      "listen_timeout": 5000,
      "max_restarts": 10,
      "min_uptime": "30s",
      "merge_logs": true,
      "time": true
    }
  ]
}
