# Base URL of the backend API. OPTIONAL — apiClient.ts already defaults to
# http://localhost:3070/api/v1 in dev and the relative /api/v1 in production,
# where the reverse proxy forwards /api/ to the backend on the same origin.
# Set this only to point at an API somewhere other than those defaults.
# VITE_API_BASE_URL=http://localhost:3070/api/v1
